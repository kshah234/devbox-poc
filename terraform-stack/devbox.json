{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": [
    "terraform@1.11.3",
    "terragrunt@0.76.6",
    "ansible@2.18.3",
    "ansible-lint@24.12.2",
    "kubectl@1.32.3",
    "kubernetes-helm@3.17.2",
    "pre-commit@4.0.1",
    "terraform-docs@0.19.0"
