{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.24.1",
    "golangci-lint@2.0.0",
    "goreleaser@2.8.1",
    "terraform@1.11.3",
    "pre-commit@4.0.1",
    "terraform-docs@0.19.0"
  ],
  "env": {
    "ENVIRONMENT": "dev",
    "TF_LOG":      "DEBUG"
  },
  "shell": {
    "init_hook": [
      "echo Welcome to Devbox!"
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}
