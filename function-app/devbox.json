{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": [
    "colima@0.8.1",
    "docker@27.5.1",
    "docker-compose@2.34.0",
    "python@3.13.2",
    "nodejs@23.10.0",
    "ruff@0.11.2",
    "pre-commit@4.0.1"
  ],
  "env": {
    "ENVIRONMENT": "dev",
    "APP_LOG":     "DEBUG"
  },
  "shell": {
    "init_hook": [
      "echo Welcome to Devbox!",
      "npm install azure-functions-core-tools@4 --unsafe-perm true"
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}
